# ── Required ──────────────────────────────────────────────────────────────────

# Your Slack Incoming Webhook URL
# Get it from: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Your Re:amaze brand slug (the subdomain you use to log in, e.g. "mystore")
REAMAZE_BRAND_SLUG=mystore

# ── Optional (but recommended) ────────────────────────────────────────────────

# A secret string you set in Re:amaze webhook settings — used to verify
# that webhook calls are genuinely from Re:amaze
REAMAZE_WEBHOOK_SECRET=your-secret-here

# Port (Railway sets this automatically)
PORT=3000
